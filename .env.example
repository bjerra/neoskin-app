# Shared login. Server-only — do not prefix these with NEXT_PUBLIC_.
# Set them in Netlify: Site configuration → Environment variables.
# Include the Functions scope (All scopes is fine) and redeploy afterwards.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Shopify Admin API used for inventory. Also server-only.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
